#!/usr/bin/env python3
"""Print the battery level of each half of a ZMK split keyboard over Bluetooth.

The central half exposes its own Battery Service and, when built with
CONFIG_ZMK_SPLIT_BLE_CENTRAL_BATTERY_LEVEL_PROXY, a second one carrying the
peripheral's level. BlueZ only surfaces the first, so read both over GATT.

usage: zmk-battery [device-name]      (default: Cradio)
"""
import re, subprocess, sys

name = sys.argv[1] if len(sys.argv) > 1 else "Cradio"
BATTERY_LEVEL = "00002a19-0000-1000-8000-00805f9b34fb"

def sh(*cmd):
    return subprocess.run(cmd, capture_output=True, text=True).stdout

devices = sh("bluetoothctl", "devices", "Connected")
m = re.search(rf"Device (\S+) {re.escape(name)}\b", devices)
if not m:
    sys.exit(f"{name} is not connected")
mac = m.group(1)
dev_path = "/org/bluez/hci0/dev_" + mac.replace(":", "_")

# Enumerate GATT characteristics from the D-Bus object tree (ordered by handle).
tree = sh("busctl", "tree", "--no-pager", "org.bluez")
chars = sorted(re.findall(rf"({re.escape(dev_path)}/service[0-9a-f]+/char[0-9a-f]+)$", tree, re.M))
levels = []
for path in chars:
    uuid = sh("busctl", "get-property", "org.bluez", path, "org.bluez.GattCharacteristic1", "UUID")
    if BATTERY_LEVEL not in uuid:
        continue
    out = sh("busctl", "call", "org.bluez", path, "org.bluez.GattCharacteristic1", "ReadValue", "a{sv}", "0")
    v = re.search(r"ay \d+ (\d+)", out)
    levels.append(int(v.group(1)) if v else None)

if not levels:
    sys.exit(f"{name}: no battery service found")
labels = ["central (left)", "peripheral (right)"] + [f"battery {i}" for i in range(3, len(levels) + 1)]
for label, level in zip(labels, levels):
    print(f"{label:20s} {level if level is not None else '?'}%")
